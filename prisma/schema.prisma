generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id          String   @id @default(cuid())
  type        String // NEED | OFFER
  title       String
  description String
  category    String // CONNECT | HEALTH | DENTAL | NUTRITION | SHELTER | VOLUNTEERS | LOGISTICS | EDUCATION
  urgency     String   @default("NORMAL") // CRITICAL | HIGH | NORMAL
  status      String   @default("OPEN") // OPEN | ASSIGNED | FULFILLED | CLOSED
  quantity    String?
  locationName String
  lat         Float?
  lng         Float?
  contactName String
  orgName     String?
  phone       String?
  whatsapp    String?
  email       String?
  manageToken String   @unique
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reports     Report[]

  @@index([type, status, category, urgency])
  @@index([createdAt])
}

// Organizations and people who receive an email the moment a matching
// listing goes live. One token serves both the confirm and unsubscribe
// links.
model Subscriber {
  id         String   @id @default(cuid())
  name       String
  orgName    String?
  email      String   @unique
  types      String   @default("ALL") // ALL | NEED | OFFER
  categories String   @default("ALL") // "ALL" or comma-separated category keys
  locale     String   @default("es")
  verified   Boolean  @default(false)
  active     Boolean  @default(true)
  token      String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// WhatsApp bot conversation state (one active flow per sender).
model BotSession {
  waId         String   @id
  step         String
  type         String?
  need         String?
  locationName String?
  urgency      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Report {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reason    String // SPAM | FALSE | OFFENSIVE | SCAM | OTHER
  comment   String?
  createdAt DateTime @default(now())

  @@index([listingId])
}
